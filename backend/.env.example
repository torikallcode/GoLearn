# Application
APP_ENV=development
PORT=8080

# Database (MySQL)
DB_DSN=root:torikal@tcp(127.0.0.1:3306)/golearn?parseTime=true&multiStatements=true&charset=utf8mb4

# Auth
JWT_SECRET=dev-secret-change-me-in-production
ACCESS_TTL=15m
REFRESH_TTL=168h

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5173

# Code runner: "playground" (Go Playground API) or "docker" (sandboxed, supports stdin)
RUNNER_MODE=playground
PLAYGROUND_URL=https://go.dev/_/compile
RUNNER_DOCKER_IMAGE=golang:1.26-alpine
RUN_TIMEOUT=8s
MAX_CODE_BYTES=65536
MAX_OUTPUT_BYTES=32768

# Rate limits (requests per minute)
RATE_LIMIT_PER_MIN=120
PLAYGROUND_RATE_PER_MIN=20
